meta {
  name: List (Admin only)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/usuarios
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

docs {
  Requires ROLE_ADMIN. Use an administrator account provisioned through the approved
  administrator workflow. Public registration never assigns this role based on email domain.
}

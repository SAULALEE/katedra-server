meta {
  name: Change My Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/usuarios/me/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "ChangeMe123!",
    "newPassword": "NewPassword456!"
  }
}

docs {
  Available to any authenticated user, not just admins. Clears mustChangePassword, which
  is how an admin-created account (see Create Admin) stops being flagged after the holder
  picks their own password.
}

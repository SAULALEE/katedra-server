meta {
  name: Delete (Admin only)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/usuarios/{{usuarioId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

docs {
  An admin cannot delete their own account this way — the service rejects it with 400 if
  the target id belongs to the authenticated caller.
}

meta {
  name: Forgot Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/password/forgot
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "demo@example.com"
  }
}

docs {
  Always answers 202 with the same message, whether or not the account exists, so it
  never reveals which emails are registered. Only LOCAL teacher and student accounts get
  a token; Google/Microsoft accounts and admins are ignored. Max 3 requests per account
  every 15 minutes.

  With PASSWORD_RECOVERY_EMAIL_ENABLED=false (default) no email is sent: read the link
  from your SMTP catcher, or generate a fresh token in a test. The raw token is never
  logged nor stored (only its SHA-256 hash).
}

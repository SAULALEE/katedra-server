meta {
  name: Reset Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{recoveryToken}}",
    "newPassword": "NewPassword123!"
  }
}

docs {
  Set {{recoveryToken}} to the `token` query param of the emailed link.
  204 on success; 400 if the token is invalid, expired or already used. A successful
  reset invalidates every JWT issued before it, so log in again afterwards.
}

# Katedra Server — environment template
#
# Copy to `.env` and fill in. `docker compose` reads `.env` automatically; to run the app
# outside Docker, export these into your shell instead.
#
#   cp .env.example .env
#
# Contributors with Doppler access can skip this file entirely and use
# `doppler run -- ./mvnw spring-boot:run`.
#
# Never commit `.env`. It is already in .gitignore.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API binds to. The API is served under the /api/v1 context path,
# so locally it lives at http://localhost:8080/api/v1
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# These three must agree with the mysql service in docker-compose.yml.
# Host is `mysql` when the app runs inside compose, `localhost` when it runs on your machine.
DB_URL=jdbc:mysql://localhost:3306/katedra_dev
DB_USER=katedra_dev
DB_PASSWORD=katedra_local

# Root password for the MySQL container only. Not used by the application.
MYSQL_ROOT_PASSWORD=root_local

# ── Authentication ────────────────────────────────────────────────────────────
# Any string of 32+ characters works locally. Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
# Token lifetime in milliseconds (3600000 = 1 hour).
JWT_EXPIRATION=3600000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of origins permitted to make credentialed requests.
# Defaults to the Vite dev server. Production MUST set this explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── OpenAI (required for content generation) ───────────────────────────────────
# Without this the app still starts, but every generation request will fail.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Social sign-in (optional) ─────────────────────────────────────────────────
# Leave blank to disable. The app starts cleanly with these unset — only the
# Google/Microsoft buttons stop working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Where to send the browser after OAuth completes. Leave blank when social sign-in is off.
FRONTEND_OAUTH_SUCCESS_URL=
FRONTEND_OAUTH_ERROR_URL=

# ── Stripe (optional, but see the caveat below) ────────────────────────────────
# Leave blank to run without billing: the app starts, and every account stays on
# the Free plan. Fill these in to exercise the checkout flow in Stripe test mode.
# `scripts/setup_stripe.py` creates the product and both prices for you.
#
# Caveat: GET /suscripciones/planes (the public pricing table the landing page
# calls, even for anonymous visitors) calls Stripe unconditionally for both
# billing cycles and returns 500 if these are unset — "leave it blank" only
# means the rest of the app tolerates it, not that endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MENSUAL=
STRIPE_PRICE_PRO_ANUAL=

# ── Production only ───────────────────────────────────────────────────────────
# Activates application-prod.properties, which declares DB_URL, DB_USER, DB_PASSWORD,
# JWT_SECRET and CORS_ALLOWED_ORIGINS with no fallback values — a missing secret then
# stops startup instead of silently running on a development default.
# SPRING_PROFILES_ACTIVE=prod
